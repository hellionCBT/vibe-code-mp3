{
  "name": "vibemp3s",
  "version": "1.0.0",
  "description": "Vibecode MP3 Downloader",
  "author": "glasg",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev-win": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.vibemp3s.app",
    "productName": "VibeMP3s",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "glasg",
      "repo": "vibecode-mp3-downloader"
    }
  },
  "dependencies": {
    "electron-log": "^5.1.0",
    "electron-updater": "^6.1.7",
    "ffbinaries": "^1.1.6",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}